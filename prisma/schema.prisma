// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  USER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY // reserved
  YEARLY // reserved
}

enum Category {
  RENT
  UTILITIES
  SUBSCRIPTION
  CLOTHING
  GROCERIES
  GYM
  ELECTRONICS
  ENTERTAINMENT
  MEDICAL
  GIFTS
  GOING_OUT
  PUBLIC_TRANSPORTATION
  TRAVEL
  BILLS
  RESTAURANT
  SHOPPING
  OTHER
}

// ---------- Auth.js (NextAuth) models ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  role          Role      @default(USER)

  // preferences
  currency String @default("CAD")
  locale   String @default("en-CA")
  theme    Theme  @default(SYSTEM)

  // Phase 2 (nullable now, no rework later)
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  accounts     Account[]
  sessions     Session[]
  transactions Transaction[]
  budgets      Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain ----------
model Transaction {
  id         String          @id @default(cuid())
  userId     String
  type       TransactionType @default(EXPENSE)
  amount     Int // minor units (cents), > 0
  currency   String          @default("CAD")
  date       DateTime        @db.Date
  category   Category
  merchant   String?
  note       String?
  receiptUrl String? // populated once storage is enabled (P1.1)

  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, type])
}

model Budget {
  id       String       @id @default(cuid())
  userId   String
  period   BudgetPeriod @default(MONTHLY)
  category Category? // null = overall monthly budget
  month    String // "YYYY-MM"
  amount   Int // minor units (cents)
  rollover Boolean      @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month]) // NULLS NOT DISTINCT enforced via migration — see prisma/migrations/20260728120200_budget_unique_nulls_not_distinct
  @@index([userId, month])
}

// ---------- Phase 2 (household/shared budgeting) ----------
model Household {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  members   User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Reserved for Phase 2 / 3 (add when built) ----------
